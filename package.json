{
  "dependencies": {
    "@biomejs/biome": "2.5.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "deepmerge": "^4.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "taze": "^19.17.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "biome format --fix --no-errors-on-unmatched"
  },
  "scripts": {
    "check:lint": "biome check --fix",
    "clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,bun.lockb}\"",
    "prepare": "husky",
    "update:deps": "taze -rw --maturity-period 3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
